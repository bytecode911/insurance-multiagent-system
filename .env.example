# Insurance compliance standard (irdai / gdpr / hipaa)
COMPLIANCE_STANDARD=irdai

# Log level (fatal | error | warn | info | debug | trace)
LOG_LEVEL=info

# Redis (for inter-agent events, optional)
REDIS_URL=redis://localhost:6379

# Cloud region / secrets vault (placeholders — do not commit real values)
CLOUD_REGION=us-east-1
SECRETS_VAULT_URL=https://your-vault.example.com/
